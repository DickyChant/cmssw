+
+# Install only the shared-library SDK needed by PanScales, not HOPPET's
+# standalone static library, examples or configuration tools.
+file(GLOB hoppet_headers "${HOPPET_DIR}/src/*.h")
+file(GLOB hoppet_detail_headers "${HOPPET_DIR}/src/hoppet/*.h")
+install(FILES ${hoppet_headers} DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+install(FILES ${hoppet_detail_headers} DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/hoppet)
+install(DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/hoppet4panscales_build/include/hoppet/"
+        DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/hoppet)
