\ No newline at end of file
+)
+
+# Export usable headers as well as the library. Several public headers are
+# symlinks into pinned submodules: COPYONLY dereferences them so an installed
+# SDK does not depend on the original source checkout.
+foreach(header_root "${CMAKE_CURRENT_SOURCE_DIR}/../submodules/AnalysisTools"
+                    "${CMAKE_CURRENT_SOURCE_DIR}")
+  file(GLOB_RECURSE public_headers RELATIVE "${header_root}"
+       "${header_root}/*.h" "${header_root}/*.hh")
+  foreach(header IN LISTS public_headers)
+    configure_file("${header_root}/${header}"
+                   "${CMAKE_CURRENT_BINARY_DIR}/install-headers/${header}" COPYONLY)
+  endforeach()
+endforeach()
+install(DIRECTORY "${CMAKE_CURRENT_BINARY_DIR}/install-headers/"
+        DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+install(FILES "${CMAKE_CURRENT_BINARY_DIR}/config.hh" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR})
+install(FILES "${CMAKE_CURRENT_SOURCE_DIR}/../LICENSE"
+        DESTINATION ${CMAKE_INSTALL_DATADIR}/PanScales)
